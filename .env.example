# ==============================================================================
# ORALYZE — Autonomous AI Spoken Assessment Platform
# Environment Configuration Template
# Copy this file to .env and provide your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY VOICE LAYER — SARVAM AI (Indian Languages & Accents)
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_DAILY_CALL_LIMIT=300
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_DEFAULT_SPEAKER=shubh

# ------------------------------------------------------------------------------
# 2. REASONING & RUBRIC GRADING ENGINE — IBM watsonx.ai Granite
# ------------------------------------------------------------------------------
# Set MOCK_MODE=0 for live AI services, or MOCK_MODE=1 for offline demo mode
MOCK_MODE=1
IBM_API_KEY=your_ibm_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here
GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct

# ------------------------------------------------------------------------------
# 3. SECONDARY ENTERPRISE SPEECH & PERSISTENCE FALLBACKS
# ------------------------------------------------------------------------------
STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com/instances/your_instance_id
TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com/instances/your_instance_id
CLOUDANT_URL=https://your-account.cloudantnosqldb.appdomain.cloud
CLOUDANT_DB=oralyze_scorecards

# ------------------------------------------------------------------------------
# 4. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
MAX_QUESTIONS=5
